{
	"name": "@ui5/lockfile-extractor",
	"version": "1.0.0",
	"private": true,
	"description": "Extract a standalone package-lock.json for a specific package from a monorepo workspace",
	"author": {
		"name": "SAP SE",
		"email": "openui5@sap.com",
		"url": "https://www.sap.com"
	},
	"license": "Apache-2.0",
	"main": "lib/extractFromWorkspaceLockfile.js",
	"bin": {
		"lockfile-extractor": "cli.js"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/UI5/cli.git",
		"directory": "internal/lockfile-extractor"
	},
	"scripts": {
		"test": "npm run lint && npm run coverage",
		"unit": "node --test test/lib/extractFromWorkspaceLockfile.js",
		"unit-watch": "node --test --watch test/lib/extractFromWorkspaceLockfile.js",
		"coverage": "node --test --experimental-test-coverage 'test/lib/extractFromWorkspaceLockfile.js'",
		"lint": "eslint ."
	},
	"keywords": [
		"npm",
		"package-lock",
		"monorepo",
		"dependencies"
	],
	"type": "module",
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0",
		"npm": ">= 8"
	},
	"devDependencies": {
		"@npmcli/arborist": "^10.0.2",
		"@npmcli/config": "^11.0.1",
		"eslint": "^10.9.1",
		"pacote": "^22.0.0"
	}
}
